# Copy to .env. Every script reads it.
CLUSTER_NAME=sandboxed-agent
AWS_REGION=us-west-2
# Your copy of demo-repo/ on GitHub, as owner/name. It must be public: the brain downloads
# it without a token.
GITHUB_REPO=AditModi/indian-numbers
# Any Claude model you can use in Bedrock, as an inference profile ID. List yours with:
# aws bedrock list-inference-profiles --query 'inferenceProfileSummaries[].inferenceProfileId'
MODEL_ID=us.anthropic.claude-sonnet-5-5
